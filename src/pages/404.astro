---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site';
---

<Layout title={`Page not found: ${SITE.name}`} description="This page doesn't exist." noindex>
  <section class="mx-auto max-w-[90rem] px-5 pt-24 sm:px-10 lg:pt-40">
    <h1 class="text-[length:var(--text-title)] leading-tight tracking-[-0.02em]">This page doesn't exist</h1>
    <p class="mt-4 max-w-[40ch] text-lead text-soft">The link may be old, or the address has a typo.</p>
    <a class="btn mt-8" href="/">Go to the home page</a>
  </section>
</Layout>
