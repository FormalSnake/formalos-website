---
import { Download } from '@lucide/astro';
import { DISTROS } from '../data/installer';
import { ISO } from '../site';
import system from '../data/screens/system.txt?raw';
import disk from '../data/screens/disk-encrypted.txt?raw';
import running from '../data/screens/install-running.txt?raw';
import done from '../data/screens/install-done.txt?raw';
import host from '../data/screens/host.txt?raw';

// Snapshots from crates/fspec-install/tests/screens (formalspec, branch installer), rendered by the
// installer's own test suite against its demo backend.
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const paint = (screen: string) =>
  escape(screen.replace(/\n$/, '')).replace(/[▌✓●⠧]/g, (c) => `<span class="mark">${c}</span>`);

const steps = [
  { id: 'system', title: 'Choose a system', body: `${DISTROS.length} distros, each with what its release model and kernel mean for you.`, screen: system },
  { id: 'disk', title: 'Choose a disk', body: 'Encrypt it with LUKS2, and get btrfs subvolumes for each system, your home and swap.', screen: disk },
  { id: 'install', title: 'Install', body: 'Twelve named steps with a live log, from partitions to bootloader.', screen: running },
  { id: 'done', title: 'Restart into it', body: 'Your spec is applied before the first login.', screen: done },
  { id: 'restore', title: 'Or restore a machine', body: 'Clone your spec repo and pick a host you already described.', screen: host },
];
---

<section id="installer" aria-labelledby="installer-title" class="pt-28 lg:pt-36">
  <div class="mx-auto max-w-[90rem] px-5 sm:px-10">
    <div class="reveal">
      <h2 id="installer-title" class="text-[length:var(--text-title)] font-medium leading-[1.05] tracking-[-0.02em]">
        The installer
      </h2>
      <p class="mt-4 max-w-[46ch] text-lead leading-snug text-soft">
        Pick a distro and a preset, and boot into a machine FormalSpec manages from day one. Or point it at your spec repo
        and get your machines back.
      </p>
      <p class="mt-4 max-w-[60ch] text-small text-soft">
        {DISTROS.length} distros, from Fedora and openSUSE to Arch, Void and AerynOS.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a class="btn" href={ISO.url}><Download size={18} aria-hidden="true" />Download the ISO</a>
        <p class="text-small text-soft">
          x86_64, about 1.2 GB. Boots from USB with Secure Boot on.{' '}
          <a class="link" href={ISO.checksums}>SHA256SUMS</a>, <a class="link" href={ISO.releases}>all versions</a>
        </p>
      </div>
    </div>

    <div class="tour reveal mt-12 grid grid-cols-1 gap-8 lg:mt-14 lg:grid-cols-12 lg:gap-x-10" style="--d: 100ms">
      <div role="tablist" aria-label="Installer screens" aria-orientation="vertical" class="flex gap-1 overflow-x-auto lg:col-span-4 lg:flex-col lg:overflow-visible">
        {steps.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${s.id}`}
            aria-controls={`screen-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="step shrink-0 rounded-[8px] px-4 py-3 text-left"
          >
            <span class="block text-ink">{s.title}</span>
            <span class="mt-1 hidden text-small text-soft lg:block">{s.body}</span>
          </button>
        ))}
      </div>

      <div data-ui class="screen-frame min-w-0 rounded-[10px] bg-[#121212] p-4 sm:p-5 lg:col-span-8">
        {steps.map((s, i) => (
          <pre
            role="tabpanel"
            id={`screen-${s.id}`}
            aria-labelledby={`tab-${s.id}`}
            hidden={i !== 0}
            class="screen m-0"
            set:html={paint(s.screen)}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .screen-frame {
    container-type: inline-size;
  }

  .screen {
    font-family: var(--font-mono);
    font-size: calc(100cqw / 80 / 0.6);
    line-height: 1.3;
    white-space: pre;
    color: var(--ink);
    overflow: hidden;
  }

  .screen :global(.mark) {
    color: var(--accent-text);
  }

  .step {
    transition: background-color 150ms ease;
  }

  .step[aria-selected='true'] {
    background: var(--raised);
  }

  .step:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 1px;
  }

  @media (hover: hover) and (pointer: fine) {
    .step[aria-selected='false']:hover {
      background: oklch(1 0 0 / 0.04);
    }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#installer [role="tab"]')];

  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
  };

  for (const [i, tab] of tabs.entries()) {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (!step) return;
      e.preventDefault();
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  }
</script>
